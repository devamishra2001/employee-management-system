# ============================================================
# EMPLOYEE MANAGEMENT SYSTEM - BACKEND ENVIRONMENT TEMPLATE
# ============================================================

# ------------------------------------------------------------
# APPLICATION
# ------------------------------------------------------------

APP_ENV=development

# Example production value:
# APP_ENV=production


# ------------------------------------------------------------
# JWT / SECURITY
# ------------------------------------------------------------

# IMPORTANT:
# Replace this with a strong random secret in the real .env file.
# Never commit the real SECRET_KEY to GitHub.

SECRET_KEY=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET

ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=480


# ------------------------------------------------------------
# LOCAL MYSQL DATABASE
#
# These values are used when DATABASE_URL is not provided.
# ------------------------------------------------------------

DB_HOST=127.0.0.1

DB_PORT=3306

DB_NAME=employee_management_system

DB_USER=root

DB_PASSWORD=YOUR_LOCAL_MYSQL_PASSWORD


# ------------------------------------------------------------
# PRODUCTION DATABASE
#
# On Render, it is preferable to set DATABASE_URL directly.
#
# Example:
#
# DATABASE_URL=mysql+pymysql://USERNAME:PASSWORD@HOST:3306/employee_management_system
#
# Leave empty for normal local development if using DB_* above.
# ------------------------------------------------------------

DATABASE_URL=


# ------------------------------------------------------------
# FRONTEND / CORS
#
# Local frontend:
# http://localhost:5173
#
# Production example:
# https://your-frontend-name.onrender.com
# ------------------------------------------------------------

FRONTEND_URL=http://localhost:5173


# ------------------------------------------------------------
# OPTIONAL SECOND LOCAL FRONTEND ORIGIN
# ------------------------------------------------------------

FRONTEND_LOCAL_URL=http://127.0.0.1:5173